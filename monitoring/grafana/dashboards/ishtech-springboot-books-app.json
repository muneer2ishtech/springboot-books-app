{
  "uid": "ishtech-springboot-books-app",
  "title": "ishtech-springboot-books-app",
  "tags": [
    "spring-boot",
    "ishtech"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ishtech-springboot-books-prometheus"
        },
        "query": {
          "query": "label_values(process_uptime_seconds, application)",
          "refId": "application"
        },
        "definition": "label_values(process_uptime_seconds, application)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape target",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "up{job=\"ishtech-springboot-books-app\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Uptime",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "process_uptime_seconds{application=\"$application\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Heap used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"heap\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Live threads",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "jvm_threads_live_threads{application=\"$application\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "HTTP request rate (excluding /actuator)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "HTTP 95th percentile latency (excluding /actuator)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"$application\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "HTTP error rate (4xx and 5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*\", status=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "HTTP average latency (excluding /actuator)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{application=\"$application\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "JVM memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "sum by (area) (jvm_memory_used_bytes{application=\"$application\"})",
          "legendFormat": "used {{area}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "sum by (area) (jvm_memory_committed_bytes{application=\"$application\"})",
          "legendFormat": "committed {{area}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "CPU usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "process_cpu_usage{application=\"$application\"}",
          "legendFormat": "process"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "system_cpu_usage{application=\"$application\"}",
          "legendFormat": "system"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "GC pause time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_sum{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{action}} ({{cause}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Database connection pool (HikariCP)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ishtech-springboot-books-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "hikaricp_connections_active{application=\"$application\"}",
          "legendFormat": "active {{pool}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "hikaricp_connections_idle{application=\"$application\"}",
          "legendFormat": "idle {{pool}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "ishtech-springboot-books-prometheus"
          },
          "expr": "hikaricp_connections_pending{application=\"$application\"}",
