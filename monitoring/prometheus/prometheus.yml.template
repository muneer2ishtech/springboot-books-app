# Prometheus configuration template for ishtech-springboot-books-app.
# At container start, docker-compose.yml replaces __SCRAPE_TARGET__ with the
# app's host:port (see MONITORING.md) and writes the result to /tmp/prometheus.yml.

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: ishtech-springboot-books-app
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ['__SCRAPE_TARGET__']
